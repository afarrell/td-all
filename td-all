#!/bin/zsh
# td-all: Show open tasks across all project directories
# Usage: td-all [td list flags...]
#
# Discovery:
#   1. Walk from $PWD up to $HOME, collecting .todos dirs
#   2. Read project roots from config, scan each + immediate children
#   3. Deduplicate and display
#
# Config: ~/.config/td-all/config (one directory per line, ~ expanded)
#
# Limits: `td list` shows 50 rows per project unless told otherwise, so td-all
# asks for $DEFAULT_LIMIT rows unless the caller passes -n/--limit, which is
# respected as given. Whenever a project's row count reaches the limit in use,
# td-all warns on stderr and names the project. A td failure is reported with
# the project name and makes td-all exit 1 after the other projects are listed.

set -eo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/td-all/config"

# Load project roots from config
PROJECT_ROOTS=()
if [[ -f "$CONFIG_FILE" ]]; then
  while IFS= read -r line; do
    line="${line%%#*}"        # strip comments
    line="${line## }"         # trim leading space
    line="${line%% }"         # trim trailing space
    [[ -z "$line" ]] && continue
    line="${line/#\~/$HOME}"  # expand ~
    PROJECT_ROOTS+=("$line")
  done < "$CONFIG_FILE"
else
  echo "No config found at $CONFIG_FILE" >&2
  echo "Create one with project root directories (one per line)." >&2
  echo "See: https://github.com/afarrell/td-all" >&2
  exit 1
fi

EXTRA_ARGS=("$@")

# A positive number, not 0 or -1: td 0.44 reads 0 as "50" and -1 as unlimited,
# td 0.69 reads 0 as unlimited and rejects negatives. A large N means the same
# thing to both.
DEFAULT_LIMIT=100000

# Find the caller's own limit and output format in the passed-through args.
# -n may be clustered behind td list's boolean short flags (-a -h -m -o -r).
user_limit=""   # empty = caller gave none
format="short"
i=1
while (( i <= ${#EXTRA_ARGS} )); do
  arg="${EXTRA_ARGS[i]}"
  case "$arg" in
    --) break ;;
    --limit=*) user_limit="${arg#--limit=}" ;;
    --limit) (( i++ )); user_limit="${EXTRA_ARGS[i]:-}" ;;
    --json|--format=json) format="json" ;;
    --long|--format=long) [[ "$format" == "json" ]] || format="long" ;;
    --format)
      (( i++ ))
      case "${EXTRA_ARGS[i]:-}" in
        json) format="json" ;;
        long) [[ "$format" == "json" ]] || format="long" ;;
      esac ;;
    --*) ;;
    -*)
      if [[ "$arg" =~ '^-[ahmor]*n(.*)$' ]]; then
        rest="${match[1]}"
        if [[ -n "$rest" ]]; then
          user_limit="${rest#=}"
        else
          (( i++ )); user_limit="${EXTRA_ARGS[i]:-}"
        fi
      fi ;;
  esac
  (( i++ ))
done

LIMIT_ARGS=()
if [[ -z "$user_limit" ]]; then
  LIMIT_ARGS=(--limit "$DEFAULT_LIMIT")
  limit="$DEFAULT_LIMIT"
else
  limit="$user_limit"
fi

warn() { print -u2 -- "td-all: WARNING: $*"; }

# Number of tasks in a `td list` result, by output format.
count_rows() {
  local dir="$1" output="$2" n
  case "$format" in
    short) n=$(print -r -- "$output" | grep -a -cv -e '^[[:space:]]*$' -e '^No issues found$') || true ;;
    json)  n=$(print -r -- "$output" | grep -a -c '^  {$') || true ;;
    long)  # long records have no reliable delimiter; count the same query as JSON
      n=$(td list --work-dir "$dir" "${LIMIT_ARGS[@]}" "${EXTRA_ARGS[@]}" --json 2>/dev/null | grep -a -c '^  {$') || true ;;
  esac
  print -r -- "${n:-0}"
}

errfile=$(mktemp "${TMPDIR:-/tmp}/td-all.XXXXXX")
trap 'rm -f "$errfile"' EXIT
failed=0
typeset -A seen  # zsh associative array for dedup

add_if_todos() {
  local dir="$1"
  if [[ -d "$dir/.todos" ]]; then
    local resolved="${dir:A}"  # zsh realpath
    if [[ -z "${seen[$resolved]:-}" ]]; then
      seen[$resolved]="$dir"
    fi
  fi
}

# 1. Walk from $PWD up to $HOME
current="$PWD"
home_resolved="${HOME:A}"
while true; do
  add_if_todos "$current"
  [[ "${current:A}" == "$home_resolved" ]] && break
  parent="${current:h}"
  [[ "$parent" == "$current" ]] && break
  current="$parent"
done

# 2. Scan project roots + immediate children
for root in "${PROJECT_ROOTS[@]}"; do
  [[ -d "$root" ]] || continue
  add_if_todos "$root"
  for child in "$root"/*(N/); do
    add_if_todos "$child"
  done
done

# 3. Sort by display path and print
if (( ${#seen} == 0 )); then
  echo "No .todos databases found"
  exit 0
fi

for resolved in ${(ok)seen}; do
  dir="${seen[$resolved]}"
  display="${dir/#$HOME/~}"

  rc=0
  output=$(td list --work-dir "$dir" "${LIMIT_ARGS[@]}" "${EXTRA_ARGS[@]}" 2>"$errfile") || rc=$?
  err=$(<"$errfile")

  if (( rc != 0 )); then
    # td prints its usage text around the real message; keep just the message.
    msg=$(print -r -- "$err" | grep -a -m1 -E '^(ERROR|Error): ' | sed -E 's/^(ERROR|Error): //') || true
    print -u2 -- "td-all: ERROR in $display: ${msg:-${err:-td exited $rc with no message}}"
    failed=1
    continue
  fi

  if [[ -n "$output" ]]; then
    echo "── $display ──"
    echo "$output" | while IFS= read -r line; do echo "$line [$display]"; done
    echo ""
  fi

  # td succeeded but said something on stderr (newer td reports its own
  # truncation there): pass it on rather than drop it.
  [[ -n "$err" ]] && warn "$display: td said: $err"

  if [[ "$limit" == <-> ]]; then
    rows=$(count_rows "$dir" "$output")
    if (( limit > 0 && rows >= limit )); then
      warn "$display: $rows tasks shown, which is the limit in use ($limit); more may be hidden. Raise -n/--limit to see them."
    elif (( limit == 0 && rows == 50 )); then
      warn "$display: exactly 50 tasks shown with --limit 0; older td versions read 0 as 50, so more may be hidden. Pass a larger -n/--limit to be sure."
    fi
  fi
done

exit $failed
